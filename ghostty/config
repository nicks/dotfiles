font-family = FiraCode Nerd Font
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-size = 16
font-thicken = true

confirm-close-surface = false
quit-after-last-window-closed = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = none
gtk-titlebar = false
macos-titlebar-style = hidden
macos-window-shadow = false
font-feature = -calt
font-feature = -dlig
font-feature = -liga

# Linux defaults (fullscreen / split zoom); free these keys for programs like emacs.
# ctrl+enter is sent as xterm's modifyOtherKeys sequence so terminal emacs sees
# C-<return> (e.g. magit's visit-file-in-worktree) rather than plain RET.
keybind = ctrl+enter=csi:27;5;13~
keybind = ctrl+shift+enter=unbind

background = 000000
foreground = ffffff

cursor-color = 66ff66
cursor-text = 000000

palette = 0=#000000
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#ffffff
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#ffffff

# glsl cursor tail (ghostty/shaders/cursor_tail.glsl).
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = true

# Machine-local overrides. install.sh links this to ghostty/config-$(hostname)
# when a matching per-host file exists. Loaded last so it wins over the above.
config-file = ?~/.config/ghostty-local.conf

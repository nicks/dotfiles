# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:/Users/nick/.docker/bin"
# End of Docker Desktop section.

# Sourced by sh, by bash login shells when .bash_profile is absent,
# and by some Linux display managers at session start.
[ -r "$HOME/src/dotfiles/shell/env.sh" ] && . "$HOME/src/dotfiles/shell/env.sh"
. "$HOME/.cargo/env"
